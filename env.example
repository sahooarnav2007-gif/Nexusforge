# =============================================================================
# NEXUSFORGE environment configuration
# =============================================================================
# Copy this file to `.env` and adjust. Every variable is prefixed with
# NEXUSFORGE_. Values shown are the built-in defaults (see core/config.py).
# The app runs with zero configuration (SQLite + local LLM + in-process
# queue); everything below is optional unless marked REQUIRED.

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# development | test | production. In production the app refuses to start
# without a real NEXUSFORGE_JWT_SECRET and serves docs at /api/docs.
NEXUSFORGE_ENVIRONMENT=development
# Verbose logging + /docs.
NEXUSFORGE_DEBUG=true
# Bind address. Use 0.0.0.0 when running in Docker / behind a proxy.
NEXUSFORGE_API_HOST=127.0.0.1
# Listen port.
NEXUSFORGE_API_PORT=8000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default: built-in SQLite (zero setup) at var/nexusforge.db. For production
# use PostgreSQL:
#   NEXUSFORGE_DATABASE_URL=postgresql+asyncpg://nexusforge:nexusforge@db:5432/nexusforge
# (docker-compose provides a ready `db` service with those credentials.)
# Inside the Docker image the SQLite path is sqlite+aiosqlite:////app/var/nexusforge.db
NEXUSFORGE_DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# REQUIRED in production (long random string, e.g. `openssl rand -hex 32`).
NEXUSFORGE_JWT_SECRET=
# Token lifetimes.
NEXUSFORGE_ACCESS_TOKEN_TTL_MINUTES=15
NEXUSFORGE_REFRESH_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
# Provider: local | openai | anthropic | gemini.
#   local     — deterministic offline rule-based model (dev/CI, no API key)
#   openai    — OpenAI-compatible endpoint (needs NEXUSFORGE_OPENAI_API_KEY)
#   anthropic — Anthropic API (needs NEXUSFORGE_ANTHROPIC_API_KEY)
#   gemini    — Google Gemini REST (needs NEXUSFORGE_GEMINI_API_KEY)
NEXUSFORGE_LLM_PROVIDER=local
# Model name for the remote providers (empty = provider default).
NEXUSFORGE_LLM_MODEL=
NEXUSFORGE_OPENAI_API_KEY=
NEXUSFORGE_ANTHROPIC_API_KEY=
NEXUSFORGE_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Sandbox
# -----------------------------------------------------------------------------
# Backend: auto | docker | process.
#   auto    — Docker if the CLI is available, else rlimit process sandbox
#   docker  — container isolation (needs Docker CLI; in compose, mount the
#             Docker socket into the api container)
#   process — rlimit-based subprocess sandbox (works everywhere, weaker isolation)
NEXUSFORGE_SANDBOX_BACKEND=auto
# Resource limits applied to sandboxed runs.
NEXUSFORGE_SANDBOX_MEMORY_MB=1024
NEXUSFORGE_SANDBOX_CPUS=2
NEXUSFORGE_SANDBOX_TIMEOUT_SECONDS=120
# Allow network access for sandboxed commands (default: none).
NEXUSFORGE_SANDBOX_NETWORK=false

# -----------------------------------------------------------------------------
# Queue
# -----------------------------------------------------------------------------
# Empty = in-process queue & event bus (single worker, default).
# Set to e.g. redis://redis:6379/0 to use the bundled Redis service.
NEXUSFORGE_REDIS_URL=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Block the run when the security scanner finds a finding at/above this level:
# critical | high | none
NEXUSFORGE_SECURITY_BLOCK_ON=critical
# Sliding-window rate limiting (per user/IP; auth endpoints stricter).
NEXUSFORGE_RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------
# Bounded repair-loop iterations (test fail -> debug -> retest).
NEXUSFORGE_MAX_AGENT_ITERATIONS=5
# Whole-run wall-clock budget in seconds.
NEXUSFORGE_MAX_EXECUTION_TIME_SECONDS=600
# Allow the explicit user-confirmed git push API (default: disabled).
NEXUSFORGE_GIT_PUSH_ENABLED=false

# -----------------------------------------------------------------------------
# Storage (rarely changed)
# -----------------------------------------------------------------------------
# Where per-run agent workspaces live (default: <project>/var/workspaces).
NEXUSFORGE_WORKSPACE_ROOT=
# JSON-lines audit log path (default: <project>/var/audit.jsonl).
NEXUSFORGE_AUDIT_LOG_PATH=